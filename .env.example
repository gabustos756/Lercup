ENV=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Local dev — SQLite (recomendado en tu Mac)
DATABASE_URL=sqlite:///database.db

# NO uses la URL interna de Railway en local (falla con "railway.internal"):
# DATABASE_URL=postgresql://...@postgres.railway.internal/...
# Para conectar a Railway desde tu Mac, usá la URL PÚBLICA del servicio Postgres.

# Optional — for scripts/create_admin.py (manual one-off, not used at app startup)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your-secure-password
# ADMIN_NAME=Administrador

# Password reset emails (Resend — https://resend.com)
# Free tier: 3,000 emails/month, 100/day
# APP_BASE_URL=https://tu-app.railway.app
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Lercup <noreply@tudominio.com>
# PASSWORD_RESET_EXPIRE_MINUTES=60
#
# Manual password reset (no email): scripts/reset_user_password.py
